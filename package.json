{
  "name": "skills",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "build:openapi-tool": "bun run --cwd packages/openapi-tool build",
    "test:openapi-tool": "bun run --cwd packages/openapi-tool test",
    "typecheck:openapi-tool": "bun run --cwd packages/openapi-tool typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
