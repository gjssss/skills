{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "paths": {
      "@djd/game-core": ["core/src/index.ts"],
      "@djd/game-web-contract": ["web-contract/src/index.ts"]
    },
    "types": ["node", "bun"],
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
